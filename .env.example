# ─────────────────────────────────────────────────────────────
# ClonerBot configuration. Copy to .env and fill in.
# NEVER commit the real .env — it holds API keys and secrets.
# ─────────────────────────────────────────────────────────────

# --- Trading mode ---------------------------------------------------------
# paper  = simulate everything, no real orders (DEFAULT, start here)
# live   = place real orders on the exchange. Only flip after paper stats.
CLONERBOT_MODE=paper

# Market type: "futures" (long+short, leverage) or "spot" (long-only).
CLONERBOT_MARKET=futures
# Futures leverage: default when a signal omits one, and the hard cap.
CLONERBOT_DEFAULT_LEVERAGE=3
CLONERBOT_MAX_LEVERAGE=20
# Auto-reduce leverage so the stop sits inside the liquidation price
# (stop_distance <= this / leverage). 0.8 = comfortable margin.
CLONERBOT_LIQUIDATION_SAFETY=0.8

# --- Storage --------------------------------------------------------------
# Default is a local SQLite file so the bot runs with zero infra.
# For production use Postgres, e.g.:
#   postgresql+asyncpg://user:pass@localhost:5432/clonerbot
CLONERBOT_DATABASE_URL=sqlite+aiosqlite:///./clonerbot.db

# Redis for the signal queue. Leave empty to use an in-process queue
# (fine for a single-process paper run; use Redis in production).
CLONERBOT_REDIS_URL=

# --- Telegram: reading signal channels (Telethon user session) ------------
# Get api_id / api_hash from https://my.telegram.org (API development tools).
# A USER account is required — bots cannot read arbitrary channels.
CLONERBOT_TG_API_ID=
CLONERBOT_TG_API_HASH=
CLONERBOT_TG_SESSION=clonerbot_user
# Comma-separated channel usernames or ids to follow, e.g. @somechannel,-1001234567890
CLONERBOT_TG_CHANNELS=

# --- Telegram: control bot (aiogram, separate BOT token) ------------------
# Create via @BotFather. This is how YOU control the system and withdraw.
CLONERBOT_CONTROL_BOT_TOKEN=
# Your numeric Telegram user id(s), comma-separated. Only these can command the bot.
CLONERBOT_CONTROL_ADMIN_IDS=
# Push a message to admins on every trade open/close and channel promotion.
# Great for watching paper activity in real time. Set false to silence.
CLONERBOT_NOTIFY_TRADES=true

# --- Anthropic (LLM signal parser fallback) -------------------------------
CLONERBOT_ANTHROPIC_API_KEY=
CLONERBOT_ANTHROPIC_MODEL=claude-sonnet-5

# --- Exchanges ------------------------------------------------------------
# JSON map of exchange_id -> credentials. Only spot keys, ideally with
# withdrawals DISABLED on the API key (withdrawal is manual via control bot
# using a separately-permissioned key or the exchange UI).
# Example:
# CLONERBOT_EXCHANGES={"binance":{"apiKey":"...","secret":"..."},"bybit":{"apiKey":"...","secret":"..."}}
CLONERBOT_EXCHANGES={}

# --- Risk limits (the safety envelope replacing the human) ----------------
# Fraction of total equity risked per trade (0.01 = 1%).
CLONERBOT_RISK_PER_TRADE=0.01
# Max number of simultaneously open positions.
CLONERBOT_MAX_OPEN_POSITIONS=5
# Max fraction of equity in a single position.
CLONERBOT_MAX_POSITION_FRACTION=0.10
# Daily realized loss limit (fraction of equity). Hitting it halts trading for the day.
CLONERBOT_DAILY_LOSS_LIMIT=0.05
# Max total drawdown from peak equity before the KILL switch trips automatically.
CLONERBOT_MAX_DRAWDOWN=0.20
# Only trade these base assets (comma-separated). Empty = allow any (NOT recommended).
CLONERBOT_SYMBOL_WHITELIST=BTC,ETH,SOL,BNB,XRP
# Default stop-loss fraction if a signal provides none.
CLONERBOT_DEFAULT_STOP_LOSS=0.03
# Close any position still open after this many minutes (0 = disabled).
CLONERBOT_MAX_HOLD_MINUTES=0
# Override signal SL/TP with fixed percentages from entry (0 = follow signal).
# `clonerbot optimize` suggests good values for these.
CLONERBOT_STOP_LOSS_OVERRIDE_PCT=0.0
CLONERBOT_TAKE_PROFIT_OVERRIDE_PCT=0.0

# --- Protections (freqtrade-style safety locks) ---------------------------
CLONERBOT_PROTECTIONS_ENABLED=true
# After a channel's trade closes, don't re-enter it for N minutes.
CLONERBOT_COOLDOWN_MINUTES=3
# This many stop-loss exits within the window → pause ALL trading for lock_min.
CLONERBOT_STOPLOSS_GUARD_COUNT=3
CLONERBOT_STOPLOSS_GUARD_WINDOW_MIN=60
CLONERBOT_STOPLOSS_GUARD_LOCK_MIN=60
# This many consecutive losing closes on a channel → lock that channel.
CLONERBOT_LOSING_STREAK_COUNT=4
CLONERBOT_LOSING_STREAK_LOCK_MIN=180

# --- Adaptive sizing (Edge-style expectancy learning) ---------------------
# Size by each channel's measured average return; skip channels whose
# expectancy is non-positive once they have a track record.
CLONERBOT_USE_EXPECTANCY_SIZING=true
CLONERBOT_EXPECTANCY_MIN_TRADES=8
CLONERBOT_MIN_EXPECTANCY=0.0
# Ignore a signal if it arrives more than this many seconds after it was posted.
CLONERBOT_SIGNAL_MAX_AGE_SEC=300
# Trailing stop: as price rises, the stop ratchets up to price*(1-this).
# 0 disables trailing (fixed stop-loss only). Example: 0.02 = 2% trailing.
CLONERBOT_TRAILING_STOP_PCT=0.0

# --- Paper simulation realism ---
# Assumed adverse slippage per fill (fraction): buys fill higher, sells lower.
# Keeps paper PnL honest vs live. Example: 0.0005 = 5 bps.
CLONERBOT_PAPER_SLIPPAGE=0.0005

# --- Channel discovery (auto-find signal channels) -----------------------
# OFF by default. When on, the bot searches public channels by the keywords
# below and proposes candidates in the control bot; YOU /approve to join.
# Approved channels trade PAPER-ONLY until they prove out, then auto-promote
# to real trading. Discovery never auto-joins and never auto-trusts.
CLONERBOT_DISCOVERY_ENABLED=false
CLONERBOT_DISCOVERY_KEYWORDS=crypto signals,futures signals,trading signals
CLONERBOT_DISCOVERY_INTERVAL_SEC=3600
# Also scrape tgstat.ru as an extra source (best-effort; may be blocked).
CLONERBOT_DISCOVERY_USE_TGSTAT=false
CLONERBOT_DISCOVERY_MIN_SUBSCRIBERS=1000
CLONERBOT_DISCOVERY_MAX_CANDIDATES_PER_SCAN=20
# Min seconds between joins — protects your account from Telegram bans.
CLONERBOT_JOIN_COOLDOWN_SEC=1800
# Promotion gate: a channel trades real money only after this many closed paper
# trades with at least this win rate (and positive cumulative PnL).
CLONERBOT_PROMOTE_MIN_TRADES=10
CLONERBOT_PROMOTE_MIN_WINRATE=0.55
# Auto-demote back to paper if win rate falls below this after enough trades.
CLONERBOT_DEMOTE_WINRATE=0.40
